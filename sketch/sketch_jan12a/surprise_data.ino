// Helper function to get a surprise response by index
// Returns NULL if index is out of bounds
SurpriseResponse getSurpriseResponse(int index) {
  if (index < 0 || index >= SURPRISE_RESPONSE_COUNT) {
    return {0, 0, "", "", ""};
  }

  SurpriseResponse result;
  memcpy_P(&result, &surpriseResponses[index], sizeof(SurpriseResponse));
  return result;
}

// Helper function to get a random surprise response for a given instruction and question
// Returns -1 if no matching response found
int getRandomSurpriseIndex(uint8_t instructionIdx, uint8_t questionIdx) {
  // Count matching responses
  int matchCount = 0;
  int matchIndices[SURPRISE_RESPONSE_COUNT];

  for (int i = 0; i < SURPRISE_RESPONSE_COUNT; i++) {
    SurpriseResponse resp;
    memcpy_P(&resp, &surpriseResponses[i], sizeof(SurpriseResponse));

    if (resp.instructionIndex == instructionIdx && resp.questionIndex == questionIdx) {
      matchIndices[matchCount++] = i;
    }
  }

  if (matchCount == 0) {
    return -1;
  }

  // Return random index from matches
  return matchIndices[random(0, matchCount)];
}

// Helper function to read a string from PROGMEM into a String object
String readProgmemString(const char* progmemStr) {
  char buffer[256];  // Adjust size as needed
  strcpy_P(buffer, progmemStr);
  return String(buffer);
}
