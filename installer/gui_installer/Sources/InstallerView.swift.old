import SwiftUI

struct InstallerView: View {
    @StateObject private var viewModel = InstallerViewModel()

    var body: some View {
        VStack(spacing: 0) {
            // Header with Firebird branding
            HeaderView()

            // Main content
            ScrollView {
                VStack(spacing: 24) {
                    // Device Selection
                    DeviceSelectionView(viewModel: viewModel)

                    // Configuration (only show if not flashing)
                    if !viewModel.isFlashing {
                        ConfigurationView(viewModel: viewModel)
                    }

                    // Progress (only show when flashing)
                    if viewModel.isFlashing {
                        ProgressView(viewModel: viewModel)
                    }

                    // Flash Button
                    FlashButtonView(viewModel: viewModel)
                }
                .padding(30)
            }
        }
        .background(Color(NSColor.windowBackgroundColor))
    }
}

struct HeaderView: View {
    var body: some View {
        ZStack {
            // Gradient background
            LinearGradient(
                colors: [Color(red: 0.29, green: 0.56, blue: 0.89), Color(red: 0.20, green: 0.40, blue: 0.70)],
                startPoint: .topLeading,
                endPoint: .bottomTrailing
            )
            .frame(height: 120)

            VStack(spacing: 8) {
                // Firebird icon placeholder (you can add actual image)
                Image(systemName: "flame.fill")
                    .font(.system(size: 40))
                    .foregroundColor(.white)

                Text("Firebird AI Stick Installer")
                    .font(.system(size: 28, weight: .bold))
                    .foregroundColor(.white)
            }
        }
    }
}

struct DeviceSelectionView: View {
    @ObservedObject var viewModel: InstallerViewModel

    var body: some View {
        GroupBox {
            VStack(alignment: .leading, spacing: 12) {
                HStack {
                    Label("Device Selection", systemImage: "cable.connector")
                        .font(.headline)

                    Spacer()

                    Button(action: viewModel.refreshDevices) {
                        Image(systemName: "arrow.clockwise")
                            .font(.system(size: 14))
                    }
                    .buttonStyle(.borderless)
                    .disabled(viewModel.isFlashing)
                }

                if viewModel.devices.isEmpty {
                    HStack {
                        Image(systemName: "exclamationmark.triangle.fill")
                            .foregroundColor(.orange)
                        Text("No devices detected. Connect your M5StickC Plus2 via USB.")
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                    }
                    .padding(.vertical, 8)
                } else {
                    Picker("Serial Port:", selection: $viewModel.selectedDevice) {
                        ForEach(viewModel.devices) { device in
                            Text(device.displayName).tag(device as Device?)
                        }
                    }
                    .pickerStyle(.menu)
                    .disabled(viewModel.isFlashing)
                }
            }
            .padding(12)
        }
    }
}

struct ConfigurationView: View {
    @ObservedObject var viewModel: InstallerViewModel
    @State private var showAPIKeyHelp = false

    var body: some View {
        GroupBox {
            VStack(alignment: .leading, spacing: 16) {
                Label("Device Configuration (Optional)", systemImage: "gearshape.2")
                    .font(.headline)

                Text("Configure your device now, or skip and set up later via the device.")
                    .font(.subheadline)
                    .foregroundColor(.secondary)

                Divider()

                // OpenAI API Key
                VStack(alignment: .leading, spacing: 8) {
                    HStack {
                        Text("OpenAI API Key:")
                            .font(.subheadline)

                        Button(action: { showAPIKeyHelp.toggle() }) {
                            Image(systemName: "questionmark.circle")
                                .font(.system(size: 12))
                        }
                        .buttonStyle(.borderless)
                        .popover(isPresented: $showAPIKeyHelp) {
                            Text("Get your API key from platform.openai.com")
                                .padding()
                                .frame(width: 250)
                        }
                    }

                    SecureField("sk-proj-...", text: $viewModel.apiKey)
                        .textFieldStyle(.roundedBorder)
                        .font(.system(.body, design: .monospaced))
                }

                // WiFi Configuration
                VStack(alignment: .leading, spacing: 8) {
                    Text("WiFi Network:")
                        .font(.subheadline)

                    TextField("Network Name (SSID)", text: $viewModel.wifiSSID)
                        .textFieldStyle(.roundedBorder)

                    SecureField("WiFi Password", text: $viewModel.wifiPassword)
                        .textFieldStyle(.roundedBorder)
                        .disabled(viewModel.wifiSSID.isEmpty)
                }
            }
            .padding(12)
        }
    }
}

struct ProgressView: View {
    @ObservedObject var viewModel: InstallerViewModel

    var body: some View {
        GroupBox {
            VStack(spacing: 16) {
                Label("Flashing Firmware", systemImage: "arrow.down.circle.fill")
                    .font(.headline)

                SwiftUI.ProgressView(value: viewModel.progress, total: 100) {
                    Text(viewModel.statusMessage)
                        .font(.subheadline)
                }
                .progressViewStyle(.linear)

                if !viewModel.logMessages.isEmpty {
                    ScrollView {
                        VStack(alignment: .leading, spacing: 4) {
                            ForEach(viewModel.logMessages.suffix(10), id: \.self) { message in
                                Text(message)
                                    .font(.system(.caption, design: .monospaced))
                                    .foregroundColor(.secondary)
                            }
                        }
                        .frame(maxWidth: .infinity, alignment: .leading)
                    }
                    .frame(height: 120)
                    .background(Color(NSColor.textBackgroundColor))
                    .cornerRadius(6)
                }
            }
            .padding(12)
        }
    }
}

struct FlashButtonView: View {
    @ObservedObject var viewModel: InstallerViewModel

    var body: some View {
        VStack(spacing: 12) {
            if let error = viewModel.errorMessage {
                HStack {
                    Image(systemName: "exclamationmark.octagon.fill")
                        .foregroundColor(.red)
                    Text(error)
                        .font(.subheadline)
                        .foregroundColor(.red)
                }
                .padding()
                .background(Color.red.opacity(0.1))
                .cornerRadius(8)
            }

            if viewModel.isComplete {
                HStack {
                    Image(systemName: "checkmark.circle.fill")
                        .foregroundColor(.green)
                        .font(.system(size: 24))
                    VStack(alignment: .leading) {
                        Text("Firmware Flashed Successfully!")
                            .font(.headline)
                            .foregroundColor(.green)
                        Text("You can now disconnect the device and press the reset button.")
                            .font(.subheadline)
                            .foregroundColor(.secondary)
                    }
                }
                .padding()
                .background(Color.green.opacity(0.1))
                .cornerRadius(8)
            }

            Button(action: viewModel.startFlashing) {
                HStack {
                    Image(systemName: viewModel.isFlashing ? "hourglass" : "bolt.fill")
                        .foregroundColor(.white)
                    Text(viewModel.isFlashing ? "Flashing..." : "Flash Firmware")
                        .font(.headline)
                        .foregroundColor(.white)
                }
                .frame(maxWidth: .infinity)
                .frame(height: 50)
                .background(Color(red: 0.29, green: 0.56, blue: 0.89))
                .cornerRadius(8)
            }
            .buttonStyle(PlainButtonStyle())
            .disabled(viewModel.selectedDevice == nil || viewModel.isFlashing)
            .opacity((viewModel.selectedDevice == nil || viewModel.isFlashing) ? 0.5 : 1.0)
        }
    }
}

struct InstallerView_Previews: PreviewProvider {
    static var previews: some View {
        InstallerView()
    }
}
